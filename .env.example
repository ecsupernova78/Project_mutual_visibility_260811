# Reference template. Export API values as process environment variables.
# Because Vite uses the workspace root as envDir, copy VITE_API_BASE_URL to
# .env.local in this directory when the API is remote.
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Catalog runtime behavior; no secret values belong in this file.
CATALOG_REQUEST_TIMEOUT_SECONDS=20
CATALOG_JOB_TIMEOUT_SECONDS=90
CATALOG_ENRICHMENT_TIMEOUT_SECONDS=30
CATALOG_CACHE_TTL_SECONDS=300
CATALOG_MAX_CONCURRENT_JOBS=2
