# Shared local-development defaults. Copy to .env for local overrides.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# Runtime behavior; no secret values belong in this file.
# The API intentionally disables IERS network downloads for reproducible requests.
ASTROPY_CACHE_DIR=.cache/astropy
IERS_AUTO_DOWNLOAD=false
CATALOG_REQUEST_TIMEOUT_SECONDS=20
CATALOG_MAX_ROWS=1000
